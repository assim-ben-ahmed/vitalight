{
  "name": "vitalight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python -m uvicorn --app-dir api vitalight.main:app --reload --port 8000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "cd api && python -m pytest -q",
    "train": "cd api && python -m vitalight.train",
    "golden": "node scripts/export-golden.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
